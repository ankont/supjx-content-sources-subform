<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="newsletter" method="upgrade">
    <name>PLG_NEWSLETTER_SOURCESEMAIL</name>
    <author>SuperSoft — Kontarinis Andreas</author>
    <creationDate>2026-11-24</creationDate>
    <version>1.4.1</version>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <description>PLG_NEWSLETTER_SOURCESEMAIL_DESCRIPTION</description>
    <namespace path="src">SuperSoft\Plugin\Newsletter\SourcesEmail</namespace>
    <files><folder plugin="sourcesemail">services</folder><folder>src</folder><folder>layouts</folder><folder>language</folder></files>
    <languages folder="language">
        <language tag="en-GB">en-GB/plg_newsletter_sourcesemail.ini</language>
        <language tag="en-GB">en-GB/plg_newsletter_sourcesemail.sys.ini</language>
        <language tag="el-GR">el-GR/plg_newsletter_sourcesemail.ini</language>
        <language tag="el-GR">el-GR/plg_newsletter_sourcesemail.sys.ini</language>
    </languages>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="email_private_enabled" type="radio" layout="joomla.form.field.radio.switcher" default="0" validate="options" label="PLG_NEWSLETTER_SOURCESEMAIL_EMAIL_PRIVATE_LABEL" description="PLG_NEWSLETTER_SOURCESEMAIL_EMAIL_PRIVATE_DESC">
                    <option value="0">JNO</option><option value="1">JYES</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
