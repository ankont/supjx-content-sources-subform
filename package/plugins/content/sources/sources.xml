<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="content" method="upgrade">
    <name>PLG_CONTENT_SOURCES</name>
    <author>SuperSoft - Kontarinis Andreas</author>
    <creationDate>2026-10-14</creationDate>
    <copyright>Copyright 2026 SuperSoft - Kontarinis Andreas</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <version>4.0.0</version>
    <description>PLG_CONTENT_SOURCES_XML_DESCRIPTION</description>
    <namespace path="src">SuperSoft\Plugin\Content\Sources</namespace>
    <files>
        <folder plugin="sources">services</folder>
        <folder>src</folder>
        <folder>layouts</folder>
    </files>
    <languages folder="language">
        <language tag="en-GB">en-GB/en-GB.plg_content_sources.ini</language>
        <language tag="en-GB">en-GB/en-GB.plg_content_sources.sys.ini</language>
        <language tag="el-GR">el-GR/el-GR.plg_content_sources.ini</language>
        <language tag="el-GR">el-GR/el-GR.plg_content_sources.sys.ini</language>
    </languages>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="legacy_enabled" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="PLG_CONTENT_SOURCES_LEGACY_LABEL" description="PLG_CONTENT_SOURCES_LEGACY_DESC">
                    <option value="0">JNO</option><option value="1">JYES</option>
                </field>
                <field name="subform_field_name" type="text" default="blocks" label="PLG_CONTENT_SOURCES_LEGACY_FIELD" showon="legacy_enabled:1"/>
                <field name="append_if_missing" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="PLG_CONTENT_SOURCES_LEGACY_APPEND" showon="legacy_enabled:1">
                    <option value="0">JNO</option><option value="1">JYES</option>
                </field>
                <field name="list_token_mode" type="list" default="hide" label="PLG_CONTENT_SOURCES_LIST_TOKEN_MODE_LABEL" description="PLG_CONTENT_SOURCES_LIST_TOKEN_MODE_DESC">
                    <option value="hide">PLG_CONTENT_SOURCES_LIST_TOKEN_MODE_HIDE</option>
                    <option value="placeholder">PLG_CONTENT_SOURCES_LIST_TOKEN_MODE_PLACEHOLDER</option>
                </field>
                <field name="heading_tag" type="list" default="h2" label="PLG_CONTENT_SOURCES_HEADING_TAG_LABEL">
                    <option value="h2">H2</option><option value="h3">H3</option><option value="h4">H4</option><option value="h5">H5</option><option value="div">DIV</option><option value="none">PLG_CONTENT_SOURCES_HEADING_TAG_NONE</option>
                </field>
                <field name="heading_class" type="text" default="" label="PLG_CONTENT_SOURCES_HEADING_CLASS_LABEL"/>
            </fieldset>
        </fields>
    </config>
</extension>
