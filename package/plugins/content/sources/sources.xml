<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="content" method="upgrade">
    <name>PLG_CONTENT_SOURCES</name>
    <author>SuperSoft</author>
    <creationDate>2026-05-02</creationDate>
    <copyright>(C) SuperSoft</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorEmail></authorEmail>
    <authorUrl></authorUrl>
    <version>1.2.13</version>
    <description>PLG_CONTENT_SOURCES_XML_DESCRIPTION</description>

    <namespace path="src">SuperSoft\Plugin\Content\Sources</namespace>

    <files>
        <folder plugin="sources">services</folder>
        <folder>src</folder>
    </files>

    <languages folder="language">
        <language tag="en-GB">en-GB/en-GB.plg_content_sources.ini</language>
        <language tag="en-GB">en-GB/en-GB.plg_content_sources.sys.ini</language>
        <language tag="el-GR">el-GR/el-GR.plg_content_sources.ini</language>
        <language tag="el-GR">el-GR/el-GR.plg_content_sources.sys.ini</language>
    </languages>

    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="subform_field_name"
                    type="text"
                    default=""
                    hint="PLG_CONTENT_SOURCES_SUBFORM_FIELD_NAME_HINT"
                    label="PLG_CONTENT_SOURCES_SUBFORM_FIELD_NAME_LABEL"
                    description="PLG_CONTENT_SOURCES_SUBFORM_FIELD_NAME_DESC"
                />
                <field
                    name="token_name"
                    type="text"
                    default=""
                    hint="PLG_CONTENT_SOURCES_TOKEN_NAME_HINT"
                    label="PLG_CONTENT_SOURCES_TOKEN_NAME_LABEL"
                    description="PLG_CONTENT_SOURCES_TOKEN_NAME_DESC"
                />
                <field
                    name="append_if_missing"
                    type="list"
                    default="1"
                    label="PLG_CONTENT_SOURCES_APPEND_IF_MISSING_LABEL"
                    description="PLG_CONTENT_SOURCES_APPEND_IF_MISSING_DESC"
                    filter="integer"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field
                    name="list_token_mode"
                    type="list"
                    default="hide"
                    label="PLG_CONTENT_SOURCES_LIST_TOKEN_MODE_LABEL"
                    description="PLG_CONTENT_SOURCES_LIST_TOKEN_MODE_DESC"
                >
                    <option value="hide">PLG_CONTENT_SOURCES_LIST_TOKEN_MODE_HIDE</option>
                    <option value="placeholder">PLG_CONTENT_SOURCES_LIST_TOKEN_MODE_PLACEHOLDER</option>
                </field>
                <field
                    name="heading_tag"
                    type="list"
                    default="h2"
                    label="PLG_CONTENT_SOURCES_HEADING_TAG_LABEL"
                    description="PLG_CONTENT_SOURCES_HEADING_TAG_DESC"
                >
                    <option value="h2">H2</option>
                    <option value="h3">H3</option>
                    <option value="h4">H4</option>
                    <option value="h5">H5</option>
                    <option value="div">DIV</option>
                    <option value="none">PLG_CONTENT_SOURCES_HEADING_TAG_NONE</option>
                </field>
                <field
                    name="heading_class"
                    type="text"
                    default=""
                    label="PLG_CONTENT_SOURCES_HEADING_CLASS_LABEL"
                    description="PLG_CONTENT_SOURCES_HEADING_CLASS_DESC"
                />
                <field
                    name="templates_base_path"
                    type="text"
                    default=""
                    hint="(empty = active template override path)"
                    label="PLG_CONTENT_SOURCES_TEMPLATES_BASE_PATH_LABEL"
                    description="PLG_CONTENT_SOURCES_TEMPLATES_BASE_PATH_DESC"
                />
                <field
                    name="templates_entry_file"
                    type="text"
                    default=""
                    hint="PLG_CONTENT_SOURCES_TEMPLATES_ENTRY_FILE_HINT"
                    label="PLG_CONTENT_SOURCES_TEMPLATES_ENTRY_FILE_LABEL"
                    description="PLG_CONTENT_SOURCES_TEMPLATES_ENTRY_FILE_DESC"
                />
            </fieldset>
        </fields>
    </config>
</extension>

